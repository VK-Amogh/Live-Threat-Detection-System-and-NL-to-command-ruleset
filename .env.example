# SafeSpace — Environment Configuration Example
# Copy to .env and customize. Secrets MUST NOT be committed to git.

# Server & Networking
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (Docker container on 127.0.0.1:5432)
POSTGRES_USER=safespace
POSTGRES_PASSWORD=safespace_dev_pw_change_in_prod
POSTGRES_DB=safespace_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://safespace:safespace_dev_pw_change_in_prod@127.0.0.1:5432/safespace_db

# Security & Auth
# Internal service token for loopback worker -> API calls
INTERNAL_SERVICE_TOKEN=dev_internal_service_token_replace_in_prod_64char_min
# Secret key for hashing/deriving device tokens and signing WS tickets
DEVICE_TOKEN_SECRET=dev_secret_key_for_device_tokens_and_ws_tickets_replace_me
# Initial admin credentials for CLI setup
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change_this_admin_password_123!

# Storage paths (relative to workspace root or absolute)
STORAGE_ROOT=storage
MODELS_DIR=storage/models
MEDIA_DIR=storage/media
UPLOADS_DIR=storage/uploads
OUTBOX_DIR=storage/outbox

# Ollama VLM & Chatbot
OLLAMA_URL=http://127.0.0.1:11434
VLM_MODEL=qwen2.5-vl:7b

# CORS & Client Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Optional TLS Configuration for Production
# TLS_CERT_PATH=storage/tls/server.crt
# TLS_KEY_PATH=storage/tls/server.key
