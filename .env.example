# SafeSpace environment. Copy to .env and replace every `replace_me`.
# Network addresses and per-route rules live in config/network.yaml; only secrets and overrides belong here.

API_HOST=0.0.0.0
API_PORT=8000
HTTPS_PORT=8443
TLS_ENABLED=true
ENVIRONMENT=development
LOG_LEVEL=INFO

SERVER_ID=ss-7f3c2a
SERVER_NAME=SafeSpace Laptop
DISCOVERY_PORT=47800

# Which networks the server accepts: hotspot_only (default: this laptop + the Nothing Phone hotspot),
# ibus (adds iBus over HTTPS for paired devices + a private mesh), anywhere (adds a relay you operate).
# NETWORK_MODE=hotspot_only
# TRUSTED_LAN_CIDRS=10.11.229.0/24
# IBUS_CIDRS=10.12.0.0/16
# TRUSTED_PROXIES=

# Addresses baked into the APK (scripts/build-apk.ps1 also adds the laptop's detected addresses).
PUBLIC_SERVER_URLS=http://10.11.229.33:8000
# Defaults to CAMERA_ENROLLMENT_CODE; used to sign the server's identity and route list.
# SERVER_PROOF_KEY=replace_me

INTERNAL_SERVICE_TOKEN=replace_me
DEVICE_TOKEN_SECRET=replace_me
SEED_ACCOUNTS=admin1@safespace.com:admin123:Admin 1,admin2@safespace.com:admin123:Admin 2
CAMERA_ENROLLMENT_CODE=ss-enroll-np4a-7495-9f8e7d6c5b4a3210
ADMIN_TOKEN_DAYS=30
CAMERA_TOKEN_DAYS=365
DEMO_AUTOFILL_PASSWORD=true

STORAGE_ROOT=storage
MODELS_DIR=storage/models
MEDIA_DIR=storage/media
UPLOADS_DIR=storage/uploads
OUTBOX_DIR=storage/outbox

OLLAMA_URL=http://127.0.0.1:11434
VLM_MODEL=qwen2.5-vl:7b
CHAT_PROVIDER=ollama
OLLAMA_MODEL=gemma4:e2b
OLLAMA_NUM_GPU=99

# Extra browser origins allowed to call the API (the server adds its own addresses automatically).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
