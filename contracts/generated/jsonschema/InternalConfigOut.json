{
  "$defs": {
    "CameraOut": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "connection_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connection Uri"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "is_online": {
          "default": false,
          "title": "Is Online",
          "type": "boolean"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "status": {
          "default": "offline",
          "title": "Status",
          "type": "string"
        },
        "fps": {
          "default": 0.0,
          "title": "Fps",
          "type": "number"
        },
        "width": {
          "default": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 0,
          "title": "Height",
          "type": "integer"
        },
        "viewer_count": {
          "default": 0,
          "title": "Viewer Count",
          "type": "integer"
        },
        "device_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Id"
        },
        "battery_pct": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Battery Pct"
        },
        "charging": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Charging"
        },
        "temp_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temp C"
        },
        "wifi_rssi": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wifi Rssi"
        },
        "recording_active": {
          "default": false,
          "title": "Recording Active",
          "type": "boolean"
        },
        "stealth_mode": {
          "default": false,
          "title": "Stealth Mode",
          "type": "boolean"
        },
        "torch_enabled": {
          "default": false,
          "title": "Torch Enabled",
          "type": "boolean"
        },
        "lens_facing": {
          "default": "back",
          "title": "Lens Facing",
          "type": "string"
        },
        "capture_profile": {
          "default": "normal",
          "title": "Capture Profile",
          "type": "string"
        },
        "active_rules_count": {
          "default": 0,
          "title": "Active Rules Count",
          "type": "integer"
        },
        "geometry": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Geometry"
        }
      },
      "required": [
        "id",
        "name",
        "source_type",
        "created_at"
      ],
      "title": "CameraOut",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "WEBCAM",
        "FILE",
        "RTSP",
        "PHONE"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "properties": {
    "config_version": {
      "title": "Config Version",
      "type": "integer"
    },
    "cameras": {
      "items": {
        "$ref": "#/$defs/CameraOut"
      },
      "title": "Cameras",
      "type": "array"
    },
    "enabled_categories": {
      "items": {
        "type": "string"
      },
      "title": "Enabled Categories",
      "type": "array"
    }
  },
  "required": [
    "config_version"
  ],
  "title": "InternalConfigOut",
  "type": "object"
}