[Unit]
Description=SafeSpace Threat Detection API Service
After=network.target docker.service

[Service]
Type=simple
User=safespace
WorkingDirectory=/opt/safespace
ExecStart=/opt/safespace/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5
EnvironmentFile=/opt/safespace/.env

[Install]
WantedBy=multi-user.target
