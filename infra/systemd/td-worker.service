[Unit]
Description=SafeSpace Threat Detection Inference Worker
After=network.target td-api.service ollama.service

[Service]
Type=simple
User=safespace
WorkingDirectory=/opt/safespace
ExecStart=/opt/safespace/.venv/bin/python services/inference/worker/main.py
Restart=always
RestartSec=5
EnvironmentFile=/opt/safespace/.env

[Install]
WantedBy=multi-user.target
